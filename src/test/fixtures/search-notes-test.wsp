[{"id": "search-notes-test", "workspacePosition": {"scrollX": 0, "scrollY": 0, "scale": 0.8}, "workspaceBlocks": "<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable id=\"var_result\">Result</variable></variables><block type=\"s4eblocklyframe\" id=\"frame_search\" x=\"-170\" y=\"-110\"><field name=\"NAME\">Search notes</field><statement name=\"script\"><block type=\"variables_set\" id=\"step_week\"><field name=\"VAR\" id=\"var_result\">Result</field><value name=\"VALUE\"><block type=\"s4e_periodvalue\" id=\"step_week_fetch\"><value name=\"Trackable\"><block type=\"text\" id=\"step_week_fetch_term\"><field name=\"TEXT\">gratitude</field></block></value><value name=\"Period\"><block type=\"s4e_periodpicker\" id=\"step_week_fetch_period\"><field name=\"Period\">LAST7DAYS</field></block></value><value name=\"Statistics\"><block type=\"s4e_statspicker\" id=\"step_week_fetch_stats\"><field name=\"Stats\">sum</field></block></value></block></value><next><block type=\"display\" id=\"step_week_display\"><value name=\"Value\"><block type=\"text_join\" id=\"step_week_join\" inline=\"true\"><mutation items=\"2\"></mutation><value name=\"ADD0\"><block type=\"text\" id=\"step_week_label\"><field name=\"TEXT\">Notes that mention 'gratitude' in the last 7 days: </field></block></value><value name=\"ADD1\"><block type=\"variables_get\" id=\"step_week_get\"><field name=\"VAR\" id=\"var_result\">Result</field></block></value></block></value><next><block type=\"variables_set\" id=\"step_month\"><field name=\"VAR\" id=\"var_result\">Result</field><value name=\"VALUE\"><block type=\"s4e_periodvalue\" id=\"step_month_fetch\"><value name=\"Trackable\"><block type=\"text\" id=\"step_month_fetch_term\"><field name=\"TEXT\">walk</field></block></value><value name=\"Period\"><block type=\"s4e_periodpicker\" id=\"step_month_fetch_period\"><field name=\"Period\">LAST30DAYS</field></block></value><value name=\"Statistics\"><block type=\"s4e_statspicker\" id=\"step_month_fetch_stats\"><field name=\"Stats\">sum</field></block></value></block></value><next><block type=\"display\" id=\"step_month_display\"><value name=\"Value\"><block type=\"text_join\" id=\"step_month_join\" inline=\"true\"><mutation items=\"2\"></mutation><value name=\"ADD0\"><block type=\"text\" id=\"step_month_label\"><field name=\"TEXT\">Notes that mention 'walk' in the last 30 days: </field></block></value><value name=\"ADD1\"><block type=\"variables_get\" id=\"step_month_get\"><field name=\"VAR\" id=\"var_result\">Result</field></block></value></block></value></block></next></block></next></block></next></block></statement></block></xml>", "jscode": "var Result;\n\n\nhighlightBlock('frame_search');\ns4eblocklyframe = \"activated\";\nvar schedule = \"none\";\nif (schedule == \"daily\") {\nvar scheduler = scheduler_activated();\nvar schedulerstart = scheduler_start();\nvar schedulerend = scheduler_end();\n}\nelse {var scheduler = false;\nvar schedulerstart = new Date();\nvar schedulerend = new Date();}\nvar loop = new Date(schedulerstart);\nwhile(loop <= schedulerend){\n  highlightBlock('step_week');\n  Result = (fetchPeriodValue((\"gratitude\"),(\"LAST7DAYS\"),(\"sum\")));\n  highlightBlock('step_week_display');\n  display(('Notes that mention \\'gratitude\\' in the last 7 days: ' + String(Result)));\n  highlightBlock('step_month');\n  Result = (fetchPeriodValue((\"walk\"),(\"LAST30DAYS\"),(\"sum\")));\n  highlightBlock('step_month_display');\n  display(('Notes that mention \\'walk\\' in the last 30 days: ' + String(Result)));\nvar newDate = loop.setDate(loop.getDate() + 1);\nloop = new Date(newDate);}\n", "emoji": "🔎", "color": "#DFF5E1", "name": "Search notes test", "displayName": "Search notes test", "description": "Counts notes that mention a word: gratitude (last 7 days) and walk (last 30 days), using the app's note search", "active": true, "block": "", "schedule": "none"}]